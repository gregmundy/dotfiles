# Oh My Zsh
export ZSH="$HOME/.oh-my-zsh"

# Theme handled by Starship — keep OMZ theme empty
ZSH_THEME=""

# Plugins (zsh-syntax-highlighting must be last)
plugins=(git direnv asdf zsh-autosuggestions nvm zsh-syntax-highlighting)

# Lazy-load nvm so shells start fast
zstyle ':omz:plugins:nvm' autoload true

source $ZSH/oh-my-zsh.sh

# Custom aliases, functions, PATH, and tool inits live in the dotfiles
# repo and are auto-sourced via $ZSH_CUSTOM/dotfiles.zsh, written by
# install/36-zsh-customizations.sh.

# nvm
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"
